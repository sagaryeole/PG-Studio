# Copy to .env and fill in. Never commit .env.
#
# Use a dedicated SELECT-only role (see README "Create a read-only role").
# The app also forces READ ONLY transactions, but the role is the real guarantee.
# Use 127.0.0.1, not localhost (localhost tries IPv6 first and can fail with Docker).
# If Postgres runs in Docker, use the HOST port from `docker ps` (e.g. 5433).
DATABASE_URL=postgres://pgstudio_ro:change-me@127.0.0.1:5432/mydb
# Name shown in the connection menu for DATABASE_URL.
# DATABASE_LABEL=Local dev

# More servers or nicer names: list them in connections.json
# (see connections.example.json). Optional; DATABASE_URL is listed first.
# CONNECTIONS_FILE=connections.json

# Port on 127.0.0.1. The host is not configurable on purpose.
PORT=4321

# Schema to browse. Defaults to "public".
PG_SCHEMA=public

# Per-query timeout in milliseconds (protects the DB from slow scans).
STATEMENT_TIMEOUT_MS=5000

# Max rows in one CSV/JSON export (max 100000).
EXPORT_MAX_ROWS=10000
