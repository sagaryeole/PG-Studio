# Demo-only settings for `npm run demo`. Points at the throwaway container from
# demo/docker-compose.yml, using the SELECT-only role that demo/seed.sql creates.
# These credentials only exist inside that local container.
CONNECTIONS_FILE=demo/connections.json
# The demo connections have no password in their URLs; libpq-style PGPASSWORD
# supplies it (in real setups prefer ~/.pgpass, which also works).
PGPASSWORD=demo_ro
PORT=4321
