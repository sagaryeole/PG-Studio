{
  "name": "pg-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A fast, read-only PostgreSQL browser that runs locally. Browse tables, filter, follow foreign keys and inspect structure, with no SQL sent from the browser.",
  "keywords": [
    "postgresql",
    "postgres",
    "database",
    "database-viewer",
    "database-browser",
    "database-gui",
    "postgres-gui",
    "pgadmin-alternative",
    "data-viewer",
    "read-only",
    "sql",
    "self-hosted",
    "local-first",
    "developer-tools",
    "express",
    "typescript"
  ],
  "homepage": "https://github.com/sagaryeole/PG-Studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagaryeole/PG-Studio.git"
  },
  "bugs": {
    "url": "https://github.com/sagaryeole/PG-Studio/issues"
  },
  "license": "Apache-2.0",
  "author": "sagaryeole",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:db": "docker compose -f demo/docker-compose.yml up -d --wait",
    "demo:down": "docker compose -f demo/docker-compose.yml down -v",
    "demo": "tsx watch --env-file=demo/demo.env src/server.ts",
    "test:smoke": "bash scripts/smoke-test.sh"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "pg-connection-string": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "~7.0.2"
  }
}
